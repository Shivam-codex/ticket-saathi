# Lovable Cloud (filled automatically in Lovable; copy for local dev)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Later phases
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_PROVIDER=mock
# Set true only for an isolated non-production test runtime; production always blocks mock payments.
ALLOW_MOCK_PAYMENTS=false
APP_ENV=development
# Cloudflare Turnstile (required before production launch)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false
# Optional monitoring (inactive until connected)
SENTRY_DSN=
VITE_LOVABLE_CONNECTOR_SENTRY_DSN=
VITE_LOVABLE_CONNECTOR_POSTHOG_API_KEY=
VITE_LOVABLE_CONNECTOR_POSTHOG_REGION=eu
POSTHOG_API_KEY=
POSTHOG_REGION=eu
